# Copy this file to keystore.properties (in the project root) and fill in
# the real values. keystore.properties and the keystore file itself are
# gitignored: never commit them. Share the keystore with the team privately,
# and keep a backup, because losing it means the app can never be updated on
# the Play Store.
#
# Create the keystore once with:
#   keytool -genkeypair -v -keystore waypoint-release.jks -alias waypoint \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile is relative to the project root.

storeFile=waypoint-release.jks
storePassword=
keyAlias=waypoint
keyPassword=
