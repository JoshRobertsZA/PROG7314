<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.PROG7314" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/waypoint_terracotta</item>
        <item name="android:windowBackground">@color/waypoint_splash_bg</item>
    </style>

    <style name="Theme.PROG7314" parent="Base.Theme.PROG7314" />

    <!-- System Splash Screen Theme (hides green Android icon & hands off instantly) -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/waypoint_splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.PROG7314</item>
    </style>
</resources>
