<?xml version="1.0" encoding="utf-8"?>
<!--
    isiZulu (zu) string overrides. Android picks this file up automatically
    whenever AppCompatDelegate.setApplicationLocales(zu) is active -
    stringResource() calls resolve here first, falling back to the default
    values/strings.xml for any key not overridden below.

    First-pass translation, not verified by a fluent isiZulu speaker - needs
    native-speaker review before shipping.

    Intentionally NOT overridden here (fall back to values/strings.xml):
    app_name, login_brand_name/register_brand_name ("Waypoint" - a brand
    name), every *_glyph string (single-character symbols: arrows, ✎, ✕, ↺,
    "G", "W" - not language-specific text), and the calendar_wd_*/
    new_trip_wd_* single-letter weekday abbreviations - several isiZulu
    weekday names share the same first letter (uLwesibili/uLwesithathu/
    uLwesine/uLwesihlanu all start with "L"), so a single-letter scheme
    doesn't work and needs a native speaker to pick a real abbreviation
    convention (e.g. two letters) rather than a guess.
-->
