<?xml version="1.0" encoding="utf-8"?>
<!--
    Trip calendar screen (Figma node 56:2, "04 Waypoint — Trip Calendar").
    Trip name, dates, the August 2026 day grid, and the selected-days
    summary are mock content, not live data, and are intentionally left as
    inline text (see strings.xml) since they'll be set from code once real
    trip/date data exists. Colors and static UI labels are resolved through
    colors.xml/strings.xml. See TripCalendarActivity for the (minimal)
    logic behind this screen.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tripCalendar"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/waypoint_cream"
    android:paddingStart="22dp"
    android:paddingTop="28dp"
    android:paddingEnd="22dp"
    android:paddingBottom="24dp"
    tools:context=".TripCalendarActivity">

    <!-- Scrollable so the grid doesn't get clipped on shorter screens,
         same fix applied on the home screen. -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- TopBar: back button, trip name + edit glyph (centered) -->
            <TextView
                android:id="@+id/btnBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_calendar_back_button"
                android:clickable="true"
                android:contentDescription="@string/calendar_back_cd"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:text="@string/calendar_back_glyph"
                android:textColor="@color/waypoint_terracotta"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="@id/btnBack"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/btnBack">

                <TextView
                    android:id="@+id/tvTripName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cape Town Getaway"
                    android:textColor="@color/waypoint_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- TODO: not wired to an edit-trip-name flow yet -->
                <TextView
                    android:id="@+id/tvEditTripName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/calendar_edit_trip_glyph"
                    android:textColor="@color/waypoint_terracotta"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- Trip date range / duration -->
            <TextView
                android:id="@+id/tvTripRange"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="Aug 2 – Aug 9, 2026 · 8 days"
                android:textColor="@color/waypoint_text_muted"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnBack" />

            <!-- MonthNav. TODO: prev/next don't change the displayed month yet -->
            <TextView
                android:id="@+id/btnPrevMonth"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:text="@string/calendar_prev_month_glyph"
                android:textColor="@color/waypoint_terracotta"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/tvMonthLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvMonthLabel" />

            <TextView
                android:id="@+id/tvMonthLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="August 2026"
                android:textColor="@color/waypoint_text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvTripRange" />

            <TextView
                android:id="@+id/btnNextMonth"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:text="@string/calendar_next_month_glyph"
                android:textColor="@color/waypoint_terracotta"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/tvMonthLabel"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvMonthLabel" />

            <!-- WeekdayRow -->
            <LinearLayout
                android:id="@+id/weekdayRow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvMonthLabel">

                <TextView android:layout_width="0dp" android:layout_height="16dp" android:layout_weight="1" android:gravity="center" android:text="@string/calendar_wd_sun" android:textColor="@color/waypoint_text_muted" android:textSize="11sp" android:textStyle="bold" />
                <TextView android:layout_width="0dp" android:layout_height="16dp" android:layout_weight="1" android:gravity="center" android:text="@string/calendar_wd_mon" android:textColor="@color/waypoint_text_muted" android:textSize="11sp" android:textStyle="bold" />
                <TextView android:layout_width="0dp" android:layout_height="16dp" android:layout_weight="1" android:gravity="center" android:text="@string/calendar_wd_tue" android:textColor="@color/waypoint_text_muted" android:textSize="11sp" android:textStyle="bold" />
                <TextView android:layout_width="0dp" android:layout_height="16dp" android:layout_weight="1" android:gravity="center" android:text="@string/calendar_wd_wed" android:textColor="@color/waypoint_text_muted" android:textSize="11sp" android:textStyle="bold" />
                <TextView android:layout_width="0dp" android:layout_height="16dp" android:layout_weight="1" android:gravity="center" android:text="@string/calendar_wd_thu" android:textColor="@color/waypoint_text_muted" android:textSize="11sp" android:textStyle="bold" />
                <TextView android:layout_width="0dp" android:layout_height="16dp" android:layout_weight="1" android:gravity="center" android:text="@string/calendar_wd_fri" android:textColor="@color/waypoint_text_muted" android:textSize="11sp" android:textStyle="bold" />
                <TextView android:layout_width="0dp" android:layout_height="16dp" android:layout_weight="1" android:gravity="center" android:text="@string/calendar_wd_sat" android:textColor="@color/waypoint_text_muted" android:textSize="11sp" android:textStyle="bold" />

            </LinearLayout>

            <!-- CalendarGrid: August 2026 hardcoded to match the mock design.
                 Aug 1, 2026 is a Saturday, so row 0 leads with six blank
                 slots. Blue cells (bg_calendar_day_range) mark the booked
                 trip range (Aug 2 - Aug 9); terracotta cells
                 (bg_calendar_day_selected) mark the sub-range currently
                 selected for the itinerary view (Aug 3 - Aug 5); plain
                 cells are unselected days in the month. -->
            <LinearLayout
                android:id="@+id/calendarGrid"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/weekdayRow">

                <!-- Row: blank blank blank blank blank blank 1 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <View android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" />
                    <View android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" />
                    <View android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" />
                    <View android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" />
                    <View android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" />
                    <View android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:gravity="center">
                        <TextView android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="1" android:textColor="@color/waypoint_day_muted" android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Row: 2(range) 3(selected) 4(selected) 5(selected) 6(range) 7(range) 8(range) -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:gravity="center">
                        <TextView android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_calendar_day_range" android:gravity="center" android:text="2" android:textColor="@color/white" android:textSize="13sp" android:textStyle="bold" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:gravity="center">
                        <TextView android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_calendar_day_selected" android:gravity="center" android:text="3" android:textColor="@color/white" android:textSize="13sp" android:textStyle="bold" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:gravity="center">
                        <TextView android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_calendar_day_selected" android:gravity="center" android:text="4" android:textColor="@color/white" android:textSize="13sp" android:textStyle="bold" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:gravity="center">
                        <TextView android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_calendar_day_selected" android:gravity="center" android:text="5" android:textColor="@color/white" android:textSize="13sp" android:textStyle="bold" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:gravity="center">
                        <TextView android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_calendar_day_range" android:gravity="center" android:text="6" android:textColor="@color/white" android:textSize="13sp" android:textStyle="bold" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:gravity="center">
                        <TextView android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_calendar_day_range" android:gravity="center" android:text="7" android:textColor="@color/white" android:textSize="13sp" android:textStyle="bold" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:gravity="center">
                        <TextView android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_calendar_day_range" android:gravity="center" android:text="8" android:textColor="@color/white" android:textSize="13sp" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Row: 9(range) 10 11 12 13 14 15 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:gravity="center">
                        <TextView android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_calendar_day_range" android:gravity="center" android:text="9" android:textColor="@color/white" android:textSize="13sp" android:textStyle="bold" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:gravity="center">
                        <TextView android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="10" android:textColor="@color/waypoint_day_muted" android:textSize="13sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:gravity="center">
                        <TextView android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="11" android:textColor="@color/waypoint_day_muted" android:textSize="13sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:gravity="center">
                        <TextView android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="12" android:textColor="@color/waypoint_day_muted" android:textSize="13sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:gravity="center">
                        <TextView android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="13" android:textColor="@color/waypoint_day_muted" android:textSize="13sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:gravity="center">
                        <TextView android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="14" android:textColor="@color/waypoint_day_muted" android:textSize="13sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:gravity="center">
                        <TextView android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="15" android:textColor="@color/waypoint_day_muted" android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Row: 16-22 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:gravity="center">
                        <TextView android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="16" android:textColor="@color/waypoint_day_muted" android:textSize="13sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:gravity="center">
                        <TextView android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="17" android:textColor="@color/waypoint_day_muted" android:textSize="13sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:gravity="center">
                        <TextView android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="18" android:textColor="@color/waypoint_day_muted" android:textSize="13sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:gravity="center">
                        <TextView android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="19" android:textColor="@color/waypoint_day_muted" android:textSize="13sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:gravity="center">
                        <TextView android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="20" android:textColor="@color/waypoint_day_muted" android:textSize="13sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:gravity="center">
                        <TextView android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="21" android:textColor="@color/waypoint_day_muted" android:textSize="13sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:gravity="center">
                        <TextView android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="22" android:textColor="@color/waypoint_day_muted" android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Row: 23-29 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:gravity="center">
                        <TextView android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="23" android:textColor="@color/waypoint_day_muted" android:textSize="13sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:gravity="center">
                        <TextView android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="24" android:textColor="@color/waypoint_day_muted" android:textSize="13sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:gravity="center">
                        <TextView android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="25" android:textColor="@color/waypoint_day_muted" android:textSize="13sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:gravity="center">
                        <TextView android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="26" android:textColor="@color/waypoint_day_muted" android:textSize="13sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:gravity="center">
                        <TextView android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="27" android:textColor="@color/waypoint_day_muted" android:textSize="13sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:gravity="center">
                        <TextView android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="28" android:textColor="@color/waypoint_day_muted" android:textSize="13sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:gravity="center">
                        <TextView android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="29" android:textColor="@color/waypoint_day_muted" android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Row: 30 31 blank blank blank blank blank -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:gravity="center">
                        <TextView android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="30" android:textColor="@color/waypoint_day_muted" android:textSize="13sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:gravity="center">
                        <TextView android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="31" android:textColor="@color/waypoint_day_muted" android:textSize="13sp" />
                    </LinearLayout>
                    <View android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" />
                    <View android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" />
                    <View android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" />
                    <View android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" />
                    <View android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" />
                </LinearLayout>

            </LinearLayout>

            <!-- SelectedSummary chip -->
            <TextView
                android:id="@+id/tvSelectedSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_calendar_summary_chip"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="14dp"
                android:paddingBottom="8dp"
                android:text="3 days selected · Aug 3 – Aug 5"
                android:textColor="@color/waypoint_trip_badge_text"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/calendarGrid" />

            <!-- CalendarActions. TODO: not wired to an itinerary screen yet -->
            <LinearLayout
                android:id="@+id/calendarActionsRow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="4dp"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvSelectedSummary">

                <TextView
                    android:id="@+id/btnViewItinerary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_calendar_button_outline"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:text="@string/calendar_view_itinerary"
                    android:textColor="@color/waypoint_terracotta"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnEditItinerary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_calendar_button_filled"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:text="@string/calendar_edit_itinerary"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
