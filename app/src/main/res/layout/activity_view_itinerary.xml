<?xml version="1.0" encoding="utf-8"?>
<!--
    View itinerary screen (Figma node 58:2, "05 Waypoint — View Itinerary").
    Trip name/dates, per-day weather, and every booking/place row's content
    are mock content, not live data, and are intentionally left as inline
    text (see strings.xml) since they'll be set from code once real trip/
    booking data exists. Colors and static UI labels are resolved through
    colors.xml/strings.xml. See ViewItineraryActivity for the (minimal)
    logic behind this screen.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/viewItinerary"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/waypoint_cream"
    android:paddingStart="22dp"
    android:paddingTop="28dp"
    android:paddingEnd="22dp"
    android:paddingBottom="32dp"
    tools:context=".ViewItineraryActivity">

    <!-- Scrollable so the itinerary doesn't get clipped on shorter screens,
         same fix applied on the home and trip calendar screens. -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- TopBar: back button, title + subtitle (centered) -->
            <TextView
                android:id="@+id/btnBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_itinerary_back_button"
                android:clickable="true"
                android:contentDescription="@string/itinerary_back_cd"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:text="@string/itinerary_back_glyph"
                android:textColor="@color/waypoint_terracotta"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="@id/btnBack"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/btnBack">

                <TextView
                    android:id="@+id/tvItineraryTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/itinerary_title"
                    android:textColor="@color/waypoint_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvItinerarySubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Cape Town Getaway · Aug 3 – Aug 5"
                    android:textColor="@color/waypoint_text_muted"
                    android:textSize="10sp" />

            </LinearLayout>

            <!-- WeatherRow: one chip per itinerary day -->
            <LinearLayout
                android:id="@+id/weatherRow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnBack">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_itinerary_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Aug 3" android:textColor="@color/waypoint_text_muted" android:textSize="10sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="22°C" android:textColor="@color/waypoint_text_primary" android:textSize="15sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Sunny" android:textColor="@color/waypoint_text_muted" android:textSize="10sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_itinerary_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Aug 4" android:textColor="@color/waypoint_text_muted" android:textSize="10sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="20°C" android:textColor="@color/waypoint_text_primary" android:textSize="15sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Cloudy" android:textColor="@color/waypoint_text_muted" android:textSize="10sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_itinerary_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Aug 5" android:textColor="@color/waypoint_text_muted" android:textSize="10sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="18°C" android:textColor="@color/waypoint_text_primary" android:textSize="15sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Rain" android:textColor="@color/waypoint_text_muted" android:textSize="10sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Flights -->
            <TextView
                android:id="@+id/tvFlightsHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/itinerary_header_flights"
                android:textColor="@color/waypoint_text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/weatherRow" />

            <!-- BookingRow: CPT -> JNB -->
            <LinearLayout
                android:id="@+id/flightRow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_itinerary_row"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvFlightsHeader">

                <View
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_itinerary_thumb_a" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CPT → JNB · SA 123" android:textColor="@color/waypoint_text_primary" android:textSize="13sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Aug 3 · Departs 09:40" android:textColor="@color/waypoint_text_muted" android:textSize="11sp" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_itinerary_pdf_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="9dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="9dp"
                    android:paddingBottom="5dp"
                    android:text="@string/itinerary_view_pdf"
                    android:textColor="@color/waypoint_terracotta"
                    android:textSize="9sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Lodging -->
            <TextView
                android:id="@+id/tvLodgingHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/itinerary_header_lodging"
                android:textColor="@color/waypoint_text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/flightRow" />

            <!-- BookingRow: Test Valley Boutique Hotel -->
            <LinearLayout
                android:id="@+id/lodgingRow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_itinerary_row"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvLodgingHeader">

                <View
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_itinerary_thumb_b" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Test Valley Boutique Hotel" android:textColor="@color/waypoint_text_primary" android:textSize="13sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Check-in Aug 3 · 2 nights" android:textColor="@color/waypoint_text_muted" android:textSize="11sp" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_itinerary_pdf_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="9dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="9dp"
                    android:paddingBottom="5dp"
                    android:text="@string/itinerary_view_pdf"
                    android:textColor="@color/waypoint_terracotta"
                    android:textSize="9sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Car rental -->
            <TextView
                android:id="@+id/tvCarHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/itinerary_header_car"
                android:textColor="@color/waypoint_text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/lodgingRow" />

            <!-- BookingRow: Compact Car · Avis -->
            <LinearLayout
                android:id="@+id/carRow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_itinerary_row"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvCarHeader">

                <View
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_itinerary_thumb_c" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Compact Car · Avis" android:textColor="@color/waypoint_text_primary" android:textSize="13sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Aug 3 – Aug 5 pickup" android:textColor="@color/waypoint_text_muted" android:textSize="11sp" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_itinerary_pdf_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="9dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="9dp"
                    android:paddingBottom="5dp"
                    android:text="@string/itinerary_view_pdf"
                    android:textColor="@color/waypoint_terracotta"
                    android:textSize="9sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Restaurants & cafes -->
            <TextView
                android:id="@+id/tvFoodHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/itinerary_header_food"
                android:textColor="@color/waypoint_text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/carRow" />

            <LinearLayout
                android:id="@+id/foodList"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvFoodHeader">

                <!-- PlaceRow: The Test Kitchen -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_itinerary_row"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="10dp">

                    <View
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_itinerary_thumb_d" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="The Test Kitchen" android:textColor="@color/waypoint_text_primary" android:textSize="13sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Restaurant · Aug 3" android:textColor="@color/waypoint_text_muted" android:textSize="11sp" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="19:00"
                        android:textColor="@color/waypoint_trip_badge_text"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- PlaceRow: Truth Coffee -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_itinerary_row"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="10dp">

                    <View
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_itinerary_thumb_b" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Truth Coffee" android:textColor="@color/waypoint_text_primary" android:textSize="13sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Cafe · Aug 4" android:textColor="@color/waypoint_text_muted" android:textSize="11sp" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="09:00"
                        android:textColor="@color/waypoint_trip_badge_text"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <!-- Attractions -->
            <TextView
                android:id="@+id/tvAttractionsHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/itinerary_header_attractions"
                android:textColor="@color/waypoint_text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/foodList" />

            <!-- PlaceRow: Table Mountain Cableway -->
            <LinearLayout
                android:id="@+id/attractionRow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_itinerary_row"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvAttractionsHeader">

                <View
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_itinerary_thumb_c" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Table Mountain Cableway" android:textColor="@color/waypoint_text_primary" android:textSize="13sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Attraction · Aug 4" android:textColor="@color/waypoint_text_muted" android:textSize="11sp" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="11:00"
                    android:textColor="@color/waypoint_trip_badge_text"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Entertainment -->
            <TextView
                android:id="@+id/tvEntertainmentHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/itinerary_header_entertainment"
                android:textColor="@color/waypoint_text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/attractionRow" />

            <!-- EmptyState: no entertainment mock-booked for this trip -->
            <TextView
                android:id="@+id/tvEntertainmentEmpty"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_itinerary_empty_state"
                android:gravity="center"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:text="@string/itinerary_empty_entertainment"
                android:textColor="@color/waypoint_text_muted"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvEntertainmentHeader" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
