<?xml version="1.0" encoding="utf-8"?>
<!--
    Settings screen (Figma node 83:2, "10 Waypoint — Settings").
    The notifications toggle, English/Language 1/Language 2 selection, and
    the expand chevron are all mock content, not live state - they'll be
    wired up once there's real settings persistence and localization
    switching (this app supports English, Zulu, and Xhosa per the master
    prompt; "Language 1"/"Language 2" are placeholders for those until the
    real names are wired in). The dotted/blue outlines visible around each
    row in the Figma screenshot are Figma's own dev-mode layout guides, not
    real design elements - the underlying reference code has no
    background/border on these rows, so none were added here.

    The notifications toggle (track + thumb) and the language radio
    circles are hand-built shapes rather than the Figma-exported raster
    image, matching how the rest of this app builds UI (no CheckBox/
    Switch/RadioButton widgets used anywhere else). The bell, logout, and
    globe icons are new hand-authored vector drawables (ic_bell,
    ic_logout, ic_globe), matching the existing ic_settings.xml pattern
    already used on the home screen, rather than downloading the Figma
    Code Connect placeholder icons (which point to a generic design
    system this project doesn't have).

    Colors and static labels now resolve through colors.xml/strings.xml -
    all reusing tokens already established on other screens, no new
    colors were needed.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/settings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/waypoint_cream"
    android:paddingStart="28dp"
    android:paddingTop="64dp"
    android:paddingEnd="28dp"
    android:paddingBottom="36dp"
    tools:context=".SettingsActivity">

    <!-- Scrollable so the row list doesn't get clipped on shorter screens,
         same fix applied on every other screen in this app. -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- TopBar: back button, centered title, bell shortcut -->
            <TextView
                android:id="@+id/btnBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_settings_back_button"
                android:clickable="true"
                android:contentDescription="@string/settings_back_cd"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:text="@string/settings_back_glyph"
                android:textColor="@color/waypoint_terracotta"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_title"
                android:textColor="@color/waypoint_text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/btnBack"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/btnBack" />

            <!-- TODO: not wired to a notifications feed/screen yet -->
            <ImageView
                android:id="@+id/btnTopBell"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:clickable="true"
                android:contentDescription="@string/settings_bell_cd"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_bell"
                app:layout_constraintBottom_toBottomOf="@id/btnBack"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/btnBack" />

            <!-- Notifications row -->
            <LinearLayout
                android:id="@+id/rowNotifications"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnBack">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_bell" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="@string/settings_row_notifications"
                    android:textColor="@color/waypoint_text_primary"
                    android:textSize="17sp" />

                <!-- Toggle: off state (thumb at start). Hand-built from a
                     track + thumb shape rather than a real Switch widget,
                     matching how the rest of this app builds UI. -->
                <FrameLayout
                    android:id="@+id/toggleNotifications"
                    android:layout_width="51dp"
                    android:layout_height="25dp"
                    android:clickable="true"
                    android:focusable="true">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_settings_toggle_track" />

                    <View
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        android:layout_gravity="start|center_vertical"
                        android:layout_marginStart="2dp"
                        android:background="@drawable/bg_settings_toggle_thumb" />

                </FrameLayout>

            </LinearLayout>

            <!-- Logout row -->
            <LinearLayout
                android:id="@+id/rowLogout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/rowNotifications">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_logout" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="@string/settings_row_logout"
                    android:textColor="@color/waypoint_text_primary"
                    android:textSize="17sp" />

            </LinearLayout>

            <!-- Language row: shows the currently selected language
                 (mock "English"); tapping doesn't expand anything yet -->
            <LinearLayout
                android:id="@+id/rowLanguage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/rowLogout">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_globe" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="@string/settings_row_language"
                    android:textColor="@color/waypoint_text_primary"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.6"
                    android:text="@string/settings_language_expand_glyph"
                    android:textColor="@color/waypoint_text_muted"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Language 1 row: placeholder for Zulu until wired up -->
            <LinearLayout
                android:id="@+id/rowLanguage1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/rowLanguage">

                <View
                    android:id="@+id/radioLanguage1"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_settings_radio_unselected" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="@string/settings_row_language_1"
                    android:textColor="@color/waypoint_text_primary"
                    android:textSize="17sp" />

            </LinearLayout>

            <!-- Language 2 row: placeholder for Xhosa until wired up -->
            <LinearLayout
                android:id="@+id/rowLanguage2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="4dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/rowLanguage1">

                <View
                    android:id="@+id/radioLanguage2"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_settings_radio_unselected" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="@string/settings_row_language_2"
                    android:textColor="@color/waypoint_text_primary"
                    android:textSize="17sp" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
