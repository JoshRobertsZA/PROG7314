<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for Android 11 and older (see data_extraction_rules.xml for 12+).
   Trips and settings may be backed up, but the cached third party API keys and
   per-device state must not leave the phone or be restored onto another one.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="remote_secrets_cache.xml" />
    <exclude domain="sharedpref" path="usage_guardian_prefs.xml" />
    <exclude domain="sharedpref" path="biometric_lock_prefs.xml" />
</full-backup-content>
