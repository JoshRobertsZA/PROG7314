# Paste the full Firebase service account JSON as a single-line string
# (minify it: https://jsonformatter.curiousconcept.com/ → click "Minify")
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# Port (Cloud Run sets this automatically — leave blank locally to use 8080)
PORT=8080

# Third-party API keys served to the authenticated app via GET /config/keys
# (see api/src/routes/config.js). These replace the app's old BuildConfig
# fields entirely — the app no longer holds any of its own copies.
# Same key names as apikey.properties.example at the repo root; see there
# for where each one comes from.
LOCATIONIQ_API_KEY=
EXCHANGERATE_API_KEY=
COUNTERAPI_API_KEY=
COUNTERAPI_WORKSPACE=
COUNTERAPI_PLACES_SLUG=
OPENWEATHER_API_KEY=
AIRLABS_API_KEY=

# Not a secret (Google's own docs describe the OAuth web client id as public),
# but served separately and unauthenticated via GET /config/web-client-id,
# since the app needs it before a user signs in.
FIREBASE_WEB_CLIENT_ID=
